# macOS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
.venv/
.direnv/

# Raw + intermediate data — large, and the CITES files carry redistribution terms
# (glob the contents, not the directory — git cannot un-ignore a file inside an
# excluded directory, and the inventory below has to stay tracked)
Chigualen/data/raw/*
Chigualen/data/clean/
!Chigualen/data/raw/README.md
# The three sources that cannot be downloaded, as delivered. 5.6 MB compressed,
# so the repo stays self-contained: clone + unpack + run the pipeline.
!Chigualen/data/raw/_originals/
Chigualen/data/raw/_originals/*
!Chigualen/data/raw/_originals/Chigualen.rar
Chigualen/*.csv
Chigualen/*.pdf
Chigualen/*.zip

# But DO commit the runtime outputs the app reads
!Chigualen/data/out/

# Streamlit
.streamlit/secrets.toml

# Pre-repair snapshots written by scripts/09_repair_outputs.py
Chigualen/data/out/*.pre-repair

# Static web build: data/ is regenerated from Chigualen/data/out by
# scripts/10_export_web.py, on every Netlify build. 35 MB across 513 files, all
# of it derivable — no reason to carry it in git.
web/data/
